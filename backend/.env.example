NODE_ENV=development
PORT=8080

# MongoDB — use a real URI in production, or "memory" for local-only in-memory DB
MONGODB_URI=mongodb://127.0.0.1:27017/dot
# MONGODB_URI=memory

# JWT access tokens (refresh sessions last 20 days)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Cookie policy: use "none" in production for a frontend hosted on another site.
# Production cookies are always Secure; refresh cookies are always HttpOnly.
COOKIE_SAME_SITE=lax

# CORS and post-login destination: frontend origin only, with no path.
CLIENT_URL=http://localhost:5173

# Google OAuth (Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback
# In production, set CLIENT_URL and GOOGLE_CALLBACK_URL to HTTPS URLs in Render.
