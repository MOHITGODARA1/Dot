# Copy this file to ".env" and fill in real values. Never commit ".env".

PORT=5000
NODE_ENV=development

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/dot

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string

# Access token lifetime (short) and refresh token lifetime in days (keeps users signed in)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt cost: 10 is a good balance. Higher = slower and safer.
BCRYPT_ROUNDS=10

# Comma-separated list of allowed web origins, or * for development
CORS_ORIGIN=*

# Set to true when the API runs behind a proxy / load balancer (so rate limits see real IPs)
TRUST_PROXY=false
